#ifndef DjiRCVirtualJoystickDevice_h
#define DjiRCVirtualJoystickDevice_h

#include <Availability.h>
#include <HIDDriverKit/IOUserHIDDevice.iig>

class DjiRCVirtualJoystickDevice: public IOUserHIDDevice
{
public:
    virtual OSDictionary * newDeviceDescription(void) override LOCALONLY;
    virtual OSData * newReportDescriptor(void) override LOCALONLY;

    virtual kern_return_t setReport(IOMemoryDescriptor * report,
                                    IOHIDReportType reportType,
                                    IOOptionBits options,
                                    uint32_t completionTimeout,
                                    OSAction * action) override;
};

#endif
